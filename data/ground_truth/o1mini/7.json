    "human_label": "Implement"
  },
  {
    "index": 5,
    "sentence": "This expression is telescopic.",
    "sentence-type": "answer",
    "human_label": "Analyze"
  },
  {
    "index": 6,
    "sentence": "Specifically,",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 7,
    "sentence": "\\[\n\\frac{1}{j(j-1)} = \\frac{1}{j-1} - \\frac{1}{j}.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 8,
