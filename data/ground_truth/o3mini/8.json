[
  {
    "index": 1,
    "sentence": "We want to evaluate",
    "sentence-type": "answer",
    "human_label": "Read"
  },
  {
    "index": 2,
    "sentence": "S = ∑ₙ₌₁∞ n/(n⁴ + 4).",
    "sentence-type": "answer",
    "human_label": "Read"
  },
  {
    "index": 3,
    "sentence": "Step 1.",
    "sentence-type": "answer",
    "human_label": "Monitor"
  },
  {
    "index": 4,
    "sentence": "Factorize the denominator.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 5,
    "sentence": "Notice that\n  n⁴ + 4 = n⁴ + 4n² + 4 − 4n²\n      = (n² + 2)² − (2n)²\n      = (n² + 2n + 2)(n² − 2n + 2).",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 6,
    "sentence": "Step 2.",
    "sentence-type": "answer",
    "human_label": "Monitor"
  },
  {
    "index": 7,
    "sentence": "Decompose into partial fractions.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 8,
    "sentence": "We claim that\n  n/(n⁴ + 4) = (1/4)[1/(n² − 2n + 2) − 1/(n² + 2n + 2)].",
    "sentence-type": "answer",
    "human_label": "Analyze"
  },
  {
    "index": 9,
    "sentence": "To check, combine the right-hand side:\n  (1/4)[1/(n² − 2n + 2) − 1/(n² + 2n + 2)]\n  = (1/4)[(n² + 2n + 2) − (n² − 2n + 2)] / [(n² − 2n + 2)(n² + 2n + 2)]\n  = (1/4)(4n) / (n⁴ + 4)\n  = n/(n⁴ + 4),\nso the decomposition is indeed valid.",
    "sentence-type": "answer",
    "human_label": "Verify"
  },
  {
    "index": 10,
    "sentence": "Step 3.",
    "sentence-type": "answer",
    "human_label": "Monitor"
  },
  {
    "index": 11,
    "sentence": "Rewrite the sum.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 12,
    "sentence": "Thus,\n  S = (1/4) ∑ₙ₌₁∞ [1/(n² − 2n + 2) − 1/(n² + 2n + 2)].",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 13,
    "sentence": "Notice that\n  n² − 2n + 2 = (n − 1)² + 1  and  n² + 2n + 2 = (n + 1)² + 1.",
    "sentence-type": "answer",
    "human_label": "Analyze"
  },
  {
    "index": 14,
    "sentence": "So the sum becomes\n  S = (1/4) ∑ₙ₌₁∞ [1/((n − 1)² + 1) − 1/((n + 1)² + 1)].",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 15,
    "sentence": "Step 4.",
    "sentence-type": "answer",
    "human_label": "Monitor"
  },
  {
    "index": 16,
    "sentence": "Recognize the telescoping pattern.",
    "sentence-type": "answer",
    "human_label": "Analyze"
  },
  {
    "index": 17,
    "sentence": "Write out the first few terms: For n = 1:\n  Term = 1/((1–1)² + 1) − 1/((1+1)² + 1)\n     = 1/(0² + 1) − 1/(2² + 1)\n     = 1 − 1/5.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 18,
    "sentence": "For n = 2:\n  Term = 1/((2–1)² + 1) − 1/((2+1)² + 1)\n     = 1/(1² + 1) − 1/(3² + 1)\n     = 1/2 − 1/10.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 19,
    "sentence": "For n = 3:\n  Term = 1/((3–1)² + 1) − 1/((3+1)² + 1)\n     = 1/(2² + 1) − 1/(4² + 1)\n     = 1/5 − 1/17.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 20,
    "sentence": "Continue in this fashion.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 21,
    "sentence": "Notice that many terms cancel when you sum them.",
    "sentence-type": "answer",
    "human_label": "Analyze"
  },
  {
    "index": 22,
    "sentence": "Step 5.",
    "sentence-type": "answer",
    "human_label": "Monitor"
  },
  {
    "index": 23,
    "sentence": "Telescoping the series.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 24,
    "sentence": "It is convenient to re-index the sums.",
    "sentence-type": "answer",
    "human_label": "Plan"
  },
  {
    "index": 25,
    "sentence": "Let m = n − 1 for the first sum and k = n + 1 for the second sum.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 26,
    "sentence": "Then\n  ∑ₙ₌₁∞ 1/((n − 1)² + 1) = ∑ₘ₌₀∞ 1/(m² + 1),\n  ∑ₙ₌₁∞ 1/((n + 1)² + 1) = ∑ₖ₌₂∞ 1/(k² + 1).",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 27,
    "sentence": "Therefore, the telescoped sum becomes\n  S = (1/4)[(1/(0²+1) + 1/(1²+1)) + ∑ₘ₌₂∞ 1/(m²+1) − ∑ₖ₌₂∞ 1/(k²+1)]\n     = (1/4)[1 + 1/2]\n     = (1/4)·(3/2)\n     = 3/8.",
    "sentence-type": "answer",
    "human_label": "Implement"
  },
  {
    "index": 28,
    "sentence": "Final Answer:\nThe value of the infinite sum is 3/8.",
    "sentence-type": "answer",
    "human_label": "Answer"
  }
]