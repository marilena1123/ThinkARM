[
  {
    "index": 1,
    "sentence": "Okay, so I need to evaluate the infinite sum \\(\\sum_{n=1}^{\\infty} \\frac{n}{n^{4}+4}\\).",
    "sentence-type": "think",
    "human_label": "Read"
  },
  {
    "index": 2,
    "sentence": "Hmm, infinite series can be tricky, but maybe there's a way to simplify the general term here.",
