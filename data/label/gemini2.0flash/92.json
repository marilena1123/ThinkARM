    "sentence-category-reason": "Solves the equation 2m\u22121=1 for m.",
    "sentence-category": "Implement"
  },
  {
    "index": 8,
    "sentence": "Then $(m,n)=(1,2)$ is a solution.",
    "sentence-type": "answer",
    "sentence-category-reason": "States the resulting solution pair.",
    "sentence-category": "Answer"
  },
  {
    "index": 9,
    "sentence": "If $2m-1=3$, then $2m=4$ and $m=2$.",
