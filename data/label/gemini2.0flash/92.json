[
  {
    "index": 1,
    "sentence": "Let $m$ and $n$ be positive integers such that $mn-1$ divides $(n^2-n+1)^2$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Restates the given condition of the problem without analysis.",
    "sentence-category": "Read"
  },
  {
    "index": 2,
    "sentence": "If $n=1$, then $mn-1 = m-1$ and $(n^2-n+1)^2 = (1-1+1)^2 = 1^2 = 1$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Carries out computations for the case n=1.",
    "sentence-category": "Implement"
  },
  {
    "index": 3,
    "sentence": "Then $m-1$ divides 1, so $m-1 = 1$, and $m=2$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Uses the divisibility to solve for m via direct deduction.",
    "sentence-category": "Implement"
  },
  {
    "index": 4,
    "sentence": "Then $(m,n)=(2,1)$ is a solution.",
    "sentence-type": "answer",
    "sentence-category-reason": "Explicitly states the solution pair found for this case.",
    "sentence-category": "Answer"
  },
  {
