[
  {
    "index": 1,
    "sentence": "Let $A B C D E F G H$ be a cube with side length $a$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Introduces notation by defining the cube and setting side length a.",
    "sentence-category": "Implement"
  },
  {
    "index": 2,
    "sentence": "We are given that $A G=1$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Restates the given information from the problem.",
    "sentence-category": "Read"
  },
  {
    "index": 3,
    "sentence": "$A G$ is a diagonal of the cube, so $A G^2 = A B^2 + B C^2 + C G^2 = a^2 + a^2 + a^2 = 3 a^2$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Applies the 3D Pythagorean theorem and computes AG^2.",
    "sentence-category": "Implement"
  },
  {
    "index": 4,
    "sentence": "Thus, $A G = \\sqrt{3} a$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Derives AG from the previous computation.",
    "sentence-category": "Implement"
  },
  {
    "index": 5,
    "sentence": "Since $A G = 1$, we have $\\sqrt{3} a = 1$, so $a = \\frac{1}{\\sqrt{3}}$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Solves for a using the given AG=1.",
    "sentence-category": "Implement"
  },
  {
    "index": 6,
    "sentence": "Let $A = (0, 0, 0)$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Sets up a coordinate system by assigning coordinates to A.",
    "sentence-category": "Implement"
  },
  {
    "index": 7,
    "sentence": "Then $B = (a, 0, 0)$, $C = (a, a, 0)$, $D = (0, a, 0)$, $E = (0, 0, a)$, $F = (a, 0, a)$, $G = (a, a, a)$, $H = (0, a, a)$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Assigns coordinates to all vertices based on side length a.",
    "sentence-category": "Implement"
  },
  {
    "index": 8,
    "sentence": "The center of the face $E F G H$ is $P = \\left(\\frac{a}{2}, \\frac{a}{2}, a\\right)$.",
    "sentence-type": "answer",
    "sentence-category-reason": "Computes the coordinates of the face center P.",
    "sentence-category": "Implement"
  },
  {
    "index": 9,
    "sentence": "The center of the cube is $O = \\left(\\frac{a}{2}, \\frac{a}{2}, \\frac{a}{2}\\right)$.",
